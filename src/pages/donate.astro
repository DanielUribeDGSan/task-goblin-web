---
const lang = Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'es';
const status = Astro.url.searchParams.get('status');
const copy = lang === 'en'
  ? {
      title: status === 'success' ? 'Thank you for your coffee!' : 'Support Task Notch',
      text: status === 'success'
        ? 'Your support helps keep Task Notch free and improving.'
        : 'Return to Task Notch to choose PayPal or Mercado Pago.',
      back: 'Back to Task Notch',
    }
  : {
      title: status === 'success' ? '¡Gracias por el café!' : 'Apoya a Task Notch',
      text: status === 'success'
        ? 'Tu apoyo ayuda a mantener Task Notch gratis y en constante mejora.'
        : 'Regresa a Task Notch para elegir PayPal o Mercado Pago.',
      back: 'Volver a Task Notch',
    };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{copy.title}</title>
    <style>
      :root { color-scheme: dark; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #070707; color: white; }
      main { width: min(420px, calc(100% - 40px)); text-align: center; padding: 38px; border: 1px solid #ffffff18; border-radius: 24px; background: #ffffff0a; box-sizing: border-box; }
      .cup { font-size: 48px; }
      h1 { margin: 16px 0 10px; font-size: 28px; }
      p { color: #aaa; line-height: 1.5; }
      a { display: inline-block; margin-top: 12px; color: #ffad42; text-decoration: none; font-weight: 700; }
    </style>
  </head>
  <body><main><div class="cup">☕</div><h1>{copy.title}</h1><p>{copy.text}</p><a href="/">{copy.back}</a></main></body>
</html>
