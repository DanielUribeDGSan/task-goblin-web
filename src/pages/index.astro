---
import { ClientRouter } from "astro:transitions";
import { TaskNotchLanding } from "../components/dashboard/TaskNotchLanding";
import { FloatingChat } from "../components/FloatingChat";
import { GlobalLoader } from "../components/GlobalLoader";
import "../styles/global.css";

const title = "TaskNotch — Notch Interactivo y Productividad para Mac y Windows | Task Notch App";
const description =
  "TaskNotch transforma el notch o pantalla en Mac y Windows en un centro de productividad con IA: borrador mágico, OCR, traductor de pantalla, reproductor, notas y calendario. Descarga gratis TaskNotch para macOS y Windows.";
const ogImage = `${Astro.site}/icon/TaskNotch.png`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const SITE = "https://task-goblin.com";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/task-notch/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- ═══════════════════════════════════════════
         SEO PRIMARY: Title + Description + Keywords
         Targets: task notch · tasknotch · notch mac · notch windows
         ═══════════════════════════════════════════ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="task notch, tasknotch, notch mac, notch windows, task notch windows, tasknotch windows, notch pc, notch interactivo, dynamic island windows, notch app, task notch app, TaskNotch, notch macOS, mac notch app, windows notch app, barra notch mac, barra notch windows, Task Goblin, Floaty, borrador mágico IA, OCR mac, OCR windows, screenshot to text, traductor pantalla mac, traductor pantalla windows, reproductor notch, notas mac, notas windows, herramientas mac, herramientas windows, productividad mac, productividad windows, descargar tasknotch windows, descargar tasknotch mac"
    />
    <link rel="canonical" href={canonical} />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TaskNotch - Notch Interactivo y Productividad para Mac y Windows" />
    <meta property="og:site_name" content="TaskNotch" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="TaskNotch - Notch Interactivo y Productividad para Mac y Windows" />

    <!-- Sitemap para buscadores -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="video" href="/task-notch/home.mp4" type="video/mp4" />
    <ClientRouter />
  </head>
  <body class="antialiased font-sans bg-[#202020]">
    <!-- SEO: Contenido visible para crawlers e indexación de IA (Google Gemini, Copilot, Perplexity) -->
    <noscript>
      <main style="padding:2rem;color:white;background:#202020;font-family:sans-serif;max-width:900px;margin:0 auto">
        <h1>TaskNotch — Notch Interactivo y Barra de Productividad para Mac y Windows</h1>
        <p>TaskNotch (Task Notch) transforma el notch o barra de tu Mac y PC con Windows en un centro de productividad inteligente. Descarga gratis la app para macOS (Apple Silicon e Intel) y Windows 10/11.</p>
        <h2>Funciones de TaskNotch en macOS y Windows</h2>
        <ul>
          <li>Borrador mágico con IA — elimina objetos no deseados de imágenes al instante</li>
          <li>OCR en pantalla — Screenshot to Text, extrae texto de cualquier captura en Mac y PC</li>
          <li>Traductor de pantalla con IA en tiempo real</li>
          <li>Reproductor multimedia en el notch o barra superior</li>
          <li>Notas rápidas y atajos de productividad</li>
          <li>Calendario y vista de eventos</li>
          <li>Conversor de imágenes a formato WebP optimizado</li>
          <li>Compresor de video asistido por IA</li>
          <li>Preguntas e interacción con IA sobre capturas de pantalla</li>
        </ul>
        <h2>Compatibilidad multiplataforma</h2>
        <p>Disponible para macOS (macOS 12.0 o superior, Apple Silicon M1/M2/M3/M4 y Mac Intel) y para Windows (Windows 10 y Windows 11 de 64 bits). 100% gratuito sin suscripciones.</p>
        <h2>Otras aplicaciones</h2>
        <ul>
          <li><a href="/pair-bot">Pair Bot — Tu compañero de pair programming impulsado por IA</a></li>
        </ul>
      </main>
    </noscript>
    <TaskNotchLanding client:load />
    <FloatingChat client:idle appType="task-notch" />

    <!-- ═══════════════════════════════════════════════════════════════
         JSON-LD SCHEMA — Google sitelinks + submenus (como Facebook)
         Incluye: Organization, WebSite + SearchAction, SoftwareApp x3,
                  ItemList de apps (Task Notch, Task Goblin, Floaty)
         ═══════════════════════════════════════════════════════════════ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          /* ── 1. Organization ──────────────────────────────────────── */
          {
            "@type": "Organization",
            "@id": `${SITE}/#organization`,
            name: "TaskNotch",
            alternateName: ["Task Notch", "TaskNotch App", "Task Goblin"],
            url: SITE,
            logo: {
              "@type": "ImageObject",
              "@id": `${SITE}/#logo`,
              url: `${SITE}/icon/TaskNotch.png`,
              width: 512,
              height: 512,
              caption: "TaskNotch",
            },
            sameAs: [
              "https://apps.apple.com/app/tasknotch",
            ],
          },

          /* ── 2. WebSite + SiteLinksSearchBox ─────────────────────── */
          {
            "@type": "WebSite",
            "@id": `${SITE}/#website`,
            url: `${SITE}/`,
            name: "TaskNotch",
            alternateName: "Task Notch | Notch & Productivity App para Mac y Windows",
            description: description,
            inLanguage: ["es-ES", "en-US"],
            publisher: { "@id": `${SITE}/#organization` },
            potentialAction: {
              "@type": "SearchAction",
              target: {
                "@type": "EntryPoint",
                urlTemplate: `${SITE}/?q={search_term_string}`,
              },
              "query-input": "required name=search_term_string",
            },
          },

          /* ── 3. WebPage principal ─────────────────────────────────── */
          {
            "@type": "WebPage",
            "@id": `${SITE}/#webpage`,
            url: `${SITE}/`,
            name: title,
            description: description,
            inLanguage: ["es-ES", "en-US"],
            isPartOf: { "@id": `${SITE}/#website` },
            breadcrumb: {
              "@type": "BreadcrumbList",
              itemListElement: [
                {
                  "@type": "ListItem",
                  position: 1,
                  name: "TaskNotch",
                  item: `${SITE}/`,
                },
              ],
            },
          },

          /* ── 4. SoftwareApplication — TaskNotch ───────────────────── */
          {
            "@type": "SoftwareApplication",
            "@id": `${SITE}/#software-tasknotch`,
            name: "TaskNotch",
            alternateName: ["Task Notch", "Notch Mac", "TaskNotch App", "TaskNotch Windows", "Task Notch Windows", "Notch Windows"],
            applicationCategory: "UtilitiesApplication",
            applicationSubCategory: "Productivity",
            operatingSystem: "macOS 12.0+, Windows 10, Windows 11",
            description: description,
            url: `${SITE}/`,
            image: `${SITE}/icon/TaskNotch.png`,
            screenshot: `${SITE}/icon/TaskNotch.png`,
            offers: {
              "@type": "AggregateOffer",
              lowPrice: "0",
              highPrice: "0",
              priceCurrency: "USD",
              offerCount: 1,
              offers: [
                {
                  "@type": "Offer",
                  name: "Free for macOS & Windows",
                  price: "0",
                  priceCurrency: "USD",
                  description: "Totalmente gratis para siempre para macOS y Windows, sin suscripciones ni pagos ocultos",
                },
              ],
            },
            featureList: [
              "AI Magic Eraser — Borrador mágico IA",
              "Screenshot to Text OCR (macOS & Windows)",
              "AI Screen Translator — Traductor de pantalla",
              "Notch Media Player — Reproductor en el notch / barra",
              "Quick Notes",
              "Calendar Widget",
              "PDF Tools & AI Summary",
              "Image to WebP converter",
              "Video AI Compressor",
              "Terminal in Notch",
              "Color Loupe Extractor",
              "Answer questions on screen",
            ],
            author: { "@id": `${SITE}/#organization` },
            publisher: { "@id": `${SITE}/#organization` },
          },

          /* ── 5. SoftwareApplication — Pair Bot ─────────────────────── */
          {
            "@type": "SoftwareApplication",
            "@id": `${SITE}/#software-pairbot`,
            name: "Pair Bot",
            applicationCategory: "DeveloperApplication",
            operatingSystem: "macOS, Web, Linux",
            description: "Pair Bot: tu compañero de pair programming impulsado por IA con OpenHands.",
            url: `${SITE}/pair-bot`,
            image: `${SITE}/pair-bot-logo.svg`,
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
            author: { "@id": `${SITE}/#organization` },
          },

          /* ── 6. ItemList — sitelinks Google (como Facebook submenus) ─ */
          {
            "@type": "ItemList",
            "@id": `${SITE}/#app-list`,
            name: "Aplicaciones de TaskNotch",
            description: "Apps de productividad para Mac y Windows: TaskNotch y Pair Bot.",
            numberOfItems: 2,
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: "TaskNotch — Notch Interactivo para Mac y Windows",
                description: "Transforma el notch de tu Mac y tu pantalla en Windows en un centro de productividad con IA, OCR y más. 100% gratis.",
                url: `${SITE}/`,
                image: `${SITE}/icon/TaskNotch.png`,
              },
              {
                "@type": "ListItem",
                position: 2,
                name: "Pair Bot — Pair Programming con IA",
                description: "Tu compañero de pair programming impulsado por IA con soporte multi-modelo.",
                url: `${SITE}/pair-bot`,
                image: `${SITE}/pair-bot-logo.svg`,
              },
            ],
          },
        ],
      })}
    />
  </body>
</html>
